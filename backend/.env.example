# Copia este archivo como .env para desarrollar en local (.env esta en .gitignore).
# En AWS estas variables las escribe terraform/user_data.sh.tpl; no hay credenciales de AWS aqui.

PORT=4000
AWS_REGION=us-east-1
S3_BUCKET_NAME=nombre-de-tu-bucket

# Base de datos (F2). Dejar DB_HOST vacio = la app funciona solo con S3.
# Local con docker compose --profile local:  DB_HOST=localhost, DB_USER=docmanager, DB_PASSWORD=local-dev-only, DB_SSL=false
DB_HOST=
DB_PORT=5432
DB_NAME=documents
DB_USER=
DB_PASSWORD=
# RDS exige SSL (true). El postgres local no lo tiene: pon false.
DB_SSL=true
